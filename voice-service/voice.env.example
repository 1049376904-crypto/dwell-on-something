# 拷成 /etc/voice.env 再填真值，然后 chmod 600。
# 真值永远不进仓库 —— 这两个 key 都是花钱的。

# ── TTS：模型说话用哪个声音 ───────────────────────────
ELEVENLABS_API_KEY=sk_xxxxxxxx
ELEVENLABS_VOICE_ID=xxxxxxxx
ELEVENLABS_MODEL=eleven_multilingual_v2

# 留空＝关掉微软那一档。不关的话正文会发到 wss://speech.platform.bing.com，
# 而且它冷启动要 14~31 秒，每次重启服务都要预热。
EDGE_TTS_VOICE=

# 留空＝关掉本机 say。macOS 限定，Linux 上必然失败，
# 留着只是白白等 20 秒超时。
SAY_VOICE=

# ── STT：把录音听成字 ───────────────────────────────
STT_URL=http://127.0.0.1:8022/transcribe
DASHSCOPE_API_KEY=sk-xxxxxxxx
STT_MODEL=gummy-realtime-v1

# ── 鉴权：前端请求 /api/voice/* 要带这个 ──────────────────
# openssl rand -hex 24 生一个。
# 它防的是「陌生人扫端口乱调」，防不了有心的抓包。
VOICE_TOKEN=
